#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/laborchain#contractedBy
:contractedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdf:type owl:TransitiveProperty ;
              rdfs:domain :Subcontractor ;
              rdfs:range :Contractor ,
                         :Subcontractor ;
              rdfs:label "lc:contractedBy" .


###  https://w3id.org/laborchain#employedBy
:employedBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :LaborUnit ;
            rdfs:range :Subcontractor ;
            rdfs:label "lc:employedBy" .


