#################################################################
#    Individuals
#################################################################

###  https://w3id.org/laborchain#C4
:C4 rdf:type owl:NamedIndividual ,
             :TrainingDataset ;
    rdfs:label "C4" .


###  https://w3id.org/laborchain#ChatGPT
:ChatGPT rdf:type owl:NamedIndividual ,
                  :AIModel ;
         :inheritsFrom :GPT35 ;
         rdfs:label "ChatGPT" .


###  https://w3id.org/laborchain#ChatGPT_ContentModeration
:ChatGPT_ContentModeration rdf:type owl:NamedIndividual ,
                                    :ContentModeration ;
                           rdfs:label "ChatGPT Content Moderation" .


###  https://w3id.org/laborchain#ChatGPT_RLHFAnnotation
:ChatGPT_RLHFAnnotation rdf:type owl:NamedIndividual ,
                                 :RLHFAnnotation ;
                        rdfs:label "ChatGPT RLHF Annotation" .


###  https://w3id.org/laborchain#GPT3
:GPT3 rdf:type owl:NamedIndividual ,
               :AIModel ;
      :trainedOn :C4 ,
                 :WebText ;
      rdfs:label "GPT-3" .


###  https://w3id.org/laborchain#GPT35
:GPT35 rdf:type owl:NamedIndividual ,
                :AIModel ;
       :inheritsFrom :GPT3 ;
       :trainedOn :InstructGPT_RLHF ;
       rdfs:label "GPT-3.5" .


###  https://w3id.org/laborchain#GPT4
:GPT4 rdf:type owl:NamedIndividual ,
               :AIModel ;
      :inheritsFrom :GPT35 ;
      rdfs:label "GPT-4" .


###  https://w3id.org/laborchain#GPT4o
:GPT4o rdf:type owl:NamedIndividual ,
                :AIModel ;
       :inheritsFrom :GPT4 ;
       rdfs:label "GPT-4o" .


###  https://w3id.org/laborchain#InstructGPT_RLHF
:InstructGPT_RLHF rdf:type owl:NamedIndividual ,
                           :TrainingDataset ;
                  :labeledBy :SamaKenyaWorkers ;
                  rdfs:label "InstructGPT RLHF Dataset" .


###  https://w3id.org/laborchain#Kenya
:Kenya rdf:type owl:NamedIndividual ,
                :Jurisdiction ;
       rdfs:label "Kenya" .


###  https://w3id.org/laborchain#Lineage_GPT35_to_ChatGPT
:Lineage_GPT35_to_ChatGPT rdf:type owl:NamedIndividual ,
                                   :ModelLineage ;
                          :exploitationInherited "true"^^xsd:boolean ;
                          :inheritanceDepth 2 ;
                          :inheritanceType "fine-tuning" ;
                          rdfs:label "GPT-3.5 to ChatGPT Lineage" .


###  https://w3id.org/laborchain#Lineage_GPT35_to_GPT4
:Lineage_GPT35_to_GPT4 rdf:type owl:NamedIndividual ,
                                :ModelLineage ;
                       :exploitationInherited "true"^^xsd:boolean ;
                       :inheritanceDepth 2 ;
                       :inheritanceType "fine-tuning+RLHF" ;
                       rdfs:label "GPT-3.5 to GPT-4 Lineage" .


###  https://w3id.org/laborchain#Lineage_GPT3_to_GPT35
:Lineage_GPT3_to_GPT35 rdf:type owl:NamedIndividual ,
                                :ModelLineage ;
                       :exploitationInherited "true"^^xsd:boolean ;
                       :inheritanceDepth 1 ;
                       :inheritanceType "fine-tuning+RLHF" ;
                       rdfs:label "GPT-3 to GPT-3.5 Lineage" .


###  https://w3id.org/laborchain#Lineage_GPT4_to_GPT4o
:Lineage_GPT4_to_GPT4o rdf:type owl:NamedIndividual ,
                                :ModelLineage ;
                       :exploitationInherited "true"^^xsd:boolean ;
                       :inheritanceDepth 3 ;
                       :inheritanceType "fine-tuning" ;
                       rdfs:label "GPT-4 to GPT-4o Lineage" .


###  https://w3id.org/laborchain#OpenAI
:OpenAI rdf:type owl:NamedIndividual ,
                 :Contractor ;
        rdfs:label "OpenAI" .


###  https://w3id.org/laborchain#Sama
:Sama rdf:type owl:NamedIndividual ,
               :Subcontractor ;
      :contractedBy :OpenAI ;
      rdfs:label "Sama" .


###  https://w3id.org/laborchain#SamaExploitationRecord
:SamaExploitationRecord rdf:type owl:NamedIndividual ,
                                 :AccountabilityFragmentation ,
                                 :ConsentVitiation ,
                                 :JurisdictionalArbitrage ,
                                 :LaborRightsSuppression ,
                                 :PsychologicalExploitation ,
                                 :WageExploitation ;
                        :propagatesTo :ChatGPT ,
                                      :GPT35 ,
                                      :GPT4 ,
                                      :GPT4o ;
                        :consentVitiatedByCoercion "true"^^xsd:boolean ;
                        :coreCountryWageUSD "15.0"^^xsd:float ;
                        :dataSourced "Perrigo, B. TIME Magazine, January 2023; worker testimony" ;
                        :jurisdictionArbitrageFlag "true"^^xsd:boolean ;
                        :psychologicalHarmDocumented "true"^^xsd:boolean ;
                        :psychologicalSupportProvided "false"^^xsd:boolean ;
                        :subcontractingDepth 1 ;
                        :traumaticContentProcessed "true"^^xsd:boolean ;
                        :unionizationSuppressed "true"^^xsd:boolean ;
                        :wageRatio "0.09"^^xsd:float ;
                        :wageUSD "1.32"^^xsd:float ;
                        rdfs:label "Sama Kenya Exploitation Record" .


###  https://w3id.org/laborchain#SamaKenyaWorkers
:SamaKenyaWorkers rdf:type owl:NamedIndividual ,
                           :LaborUnit ;
                  :employedBy :Sama ;
                  :hasExploitationRecord :SamaExploitationRecord ;
                  :operatesIn :Kenya ;
                  :performsTask :ChatGPT_ContentModeration ,
                                :ChatGPT_RLHFAnnotation ;
                  rdfs:label "Sama Kenya Workers" .


###  https://w3id.org/laborchain#UnitedStates
:UnitedStates rdf:type owl:NamedIndividual ,
                       :Jurisdiction ;
              rdfs:label "United States" .


###  https://w3id.org/laborchain#WebText
:WebText rdf:type owl:NamedIndividual ,
                  :TrainingDataset ;
         rdfs:label "WebText" .


