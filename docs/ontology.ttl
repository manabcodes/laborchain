@base <https://w3id.org/laborchain#> .

<https://w3id.org/laborchain> rdf:type owl:Ontology ;
                               <http://purl.org/dc/terms/description> "An ontological framework for tracing and documenting labor exploitation provenance in AI training lineages."@en ;
                               <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                               <http://purl.org/dc/terms/title> "LaborChain"@en ;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "lc" ;
                               <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/laborchain#" ;
                               owl:versionInfo "1.0.0" .

