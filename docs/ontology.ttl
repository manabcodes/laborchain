              rdfs:label "lc:performsTask" .


###  https://w3id.org/laborchain#propagatesTo
:propagatesTo rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :ExploitationRecord ;
