:hasExploitationRecord rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdfs:domain :LaborUnit ;
                       rdfs:range :ExploitationRecord ;
                       rdfs:label "lc:hasExploitationRecord" .


###  https://w3id.org/laborchain#inheritsFrom
:inheritsFrom rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :AIModel ;
