        <rdfs:range rdf:resource="https://w3id.org/laborchain#LaborTask"/>
        <rdfs:label>lc:performsTask</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#propagatesTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#propagatesTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#ExploitationRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#AIModel"/>
        <rdfs:label>lc:propagatesTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#trainedOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#trainedOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#AIModel"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#TrainingDataset"/>
        <rdfs:label>lc:trainedOn</rdfs:label>
    </owl:ObjectProperty>
    


