<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/laborchain#"
     xml:base="https://w3id.org/laborchain"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:laborchain="https://w3id.org/laborchain#">
    <owl:Ontology rdf:about="https://w3id.org/laborchain">
        <terms:description xml:lang="en">An ontological framework for tracing and documenting labor exploitation provenance in AI training lineages.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">LaborChain</terms:title>
        <vann:preferredNamespacePrefix>lc</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/laborchain#</vann:preferredNamespaceUri>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/laborchain#contractedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#contractedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#Subcontractor"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#Contractor"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#Subcontractor"/>
        <rdfs:label>lc:contractedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#employedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#employedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#LaborUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#Subcontractor"/>
        <rdfs:label>lc:employedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#hasExploitationRecord -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#hasExploitationRecord">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#LaborUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#ExploitationRecord"/>
        <rdfs:label>lc:hasExploitationRecord</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#inheritsFrom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#inheritsFrom">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#AIModel"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#AIModel"/>
        <rdfs:label>lc:inheritsFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#labeledBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#labeledBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#TrainingDataset"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#LaborUnit"/>
        <rdfs:label>lc:labeledBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#operatesIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#operatesIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laborchain#LaborUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/laborchain#Jurisdiction"/>
        <rdfs:label>lc:operatesIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laborchain#performsTask -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laborchain#performsTask">
