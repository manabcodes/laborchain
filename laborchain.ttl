@prefix lc: <https://w3id.org/laborchain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/laborchain> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://w3id.org/laborchain> rdf:type owl:Ontology ;
    dc:title "LaborChain"@en ;
    dc:description "An ontological framework for tracing and documenting labor exploitation provenance in AI training lineages."@en ;
    dc:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "lc" ;
    vann:preferredNamespaceUri "https://w3id.org/laborchain#" .


#################################################################
#    Object Properties
#################################################################

###  https://manabcodes.github.io/laborchain#contractedBy
lc:contractedBy rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain lc:Subcontractor ;
                rdfs:range lc:Contractor ,
                           lc:Subcontractor ;
                rdfs:label "lc:contractedBy"^^xsd:string .


###  https://manabcodes.github.io/laborchain#employedBy
lc:employedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain lc:LaborUnit ;
              rdfs:range lc:Subcontractor ;
              rdfs:label "lc:employedBy" .


###  https://manabcodes.github.io/laborchain#hasExploitationRecord
lc:hasExploitationRecord rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain lc:LaborUnit ;
                         rdfs:range lc:ExploitationRecord ;
                         rdfs:label "lc:hasExploitationRecord" .


###  https://manabcodes.github.io/laborchain#inheritsFrom
lc:inheritsFrom rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain lc:AIModel ;
                rdfs:range lc:AIModel ;
                rdfs:label "lc:inheritsFrom" .


###  https://w3id.org/laborchain#hasLineage
lc:hasLineage rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain lc:AIModel ;
              rdfs:range lc:ModelLineage ;
              rdfs:label "lc:hasLineage" .


###  https://manabcodes.github.io/laborchain#labeledBy
lc:labeledBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain lc:TrainingDataset ;
             rdfs:range lc:LaborUnit ;
             rdfs:label "lc:labeledBy" .


###  https://manabcodes.github.io/laborchain#operatesIn
lc:operatesIn rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain lc:LaborUnit ;
              rdfs:range lc:Jurisdiction ;
              rdfs:label "lc:operatesIn" .


###  https://manabcodes.github.io/laborchain#performsTask
lc:performsTask rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain lc:LaborUnit ;
                rdfs:range lc:LaborTask ;
                rdfs:label "lc:performsTask" .


###  https://manabcodes.github.io/laborchain#propagatesTo
lc:propagatesTo rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain lc:ExploitationRecord ;
                rdfs:range lc:AIModel ;
                rdfs:label "lc:propagatesTo" .


###  https://manabcodes.github.io/laborchain#trainedOn
lc:trainedOn rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain lc:AIModel ;
             rdfs:range lc:TrainingDataset ;
             rdfs:label "lc:trainedOn"^^xsd:string .


