#################################################################
#    Individuals
#################################################################

###  Jurisdictions
lc:Kenya rdf:type owl:NamedIndividual , lc:Jurisdiction ;
         rdfs:label "Kenya" .

lc:UnitedStates rdf:type owl:NamedIndividual , lc:Jurisdiction ;
                rdfs:label "United States" .

###  Contractor
lc:OpenAI rdf:type owl:NamedIndividual , lc:Contractor ;
          rdfs:label "OpenAI" .

###  Subcontractor
lc:Sama rdf:type owl:NamedIndividual , lc:Subcontractor ;
        rdfs:label "Sama" .

###  LaborTask
lc:ChatGPT_ContentModeration rdf:type owl:NamedIndividual , lc:ContentModeration ;
                             rdfs:label "ChatGPT Content Moderation" .

lc:ChatGPT_RLHFAnnotation rdf:type owl:NamedIndividual , lc:RLHFAnnotation ;
                          rdfs:label "ChatGPT RLHF Annotation" .

###  LaborUnit
lc:SamaKenyaWorkers rdf:type owl:NamedIndividual , lc:LaborUnit ;
                    rdfs:label "Sama Kenya Workers" ;
                    lc:employedBy lc:Sama ;
                    lc:operatesIn lc:Kenya ;
                    lc:performsTask lc:ChatGPT_ContentModeration ;
                    lc:performsTask lc:ChatGPT_RLHFAnnotation .

###  ExploitationRecord
lc:SamaExploitationRecord rdf:type owl:NamedIndividual , 
                                   lc:WageExploitation ,
                                   lc:PsychologicalExploitation ,
                                   lc:JurisdictionalArbitrage ,
                                   lc:LaborRightsSuppression ,
                                   lc:ConsentVitiation ,
                                   lc:AccountabilityFragmentation ;
          rdfs:label "Sama Kenya Exploitation Record" ;
          lc:wageUSD "1.32"^^xsd:float ;
          lc:coreCountryWageUSD "15.00"^^xsd:float ;
          lc:wageRatio "0.09"^^xsd:float ;
          lc:traumaticContentProcessed "true"^^xsd:boolean ;
          lc:psychologicalHarmDocumented "true"^^xsd:boolean ;
          lc:unionizationSuppressed "true"^^xsd:boolean ;
          lc:psychologicalSupportProvided "false"^^xsd:boolean ;
          lc:consentVitiatedByCoercion "true"^^xsd:boolean ;
          lc:subcontractingDepth "1"^^xsd:integer ;
          lc:jurisdictionArbitrageFlag "true"^^xsd:boolean ;
          lc:dataSourced "Perrigo, B. TIME Magazine, January 2023; worker testimony" .

###  Link LaborUnit to ExploitationRecord
lc:SamaKenyaWorkers lc:hasExploitationRecord lc:SamaExploitationRecord .

###  Subcontractor contracted by Contractor
lc:Sama lc:contractedBy lc:OpenAI .

###  Training Datasets
lc:WebText rdf:type owl:NamedIndividual , lc:TrainingDataset ;
           rdfs:label "WebText" .

lc:C4 rdf:type owl:NamedIndividual , lc:TrainingDataset ;
      rdfs:label "C4" .

lc:InstructGPT_RLHF rdf:type owl:NamedIndividual , lc:TrainingDataset ;
                    rdfs:label "InstructGPT RLHF Dataset" .

###  Datasets labeled by Sama workers
lc:InstructGPT_RLHF lc:labeledBy lc:SamaKenyaWorkers .

###  AI Models
lc:GPT3 rdf:type owl:NamedIndividual , lc:AIModel ;
        rdfs:label "GPT-3" ;
        lc:trainedOn lc:WebText ;
        lc:trainedOn lc:C4 .

lc:GPT35 rdf:type owl:NamedIndividual , lc:AIModel ;
         rdfs:label "GPT-3.5" ;
         lc:inheritsFrom lc:GPT3 ;
         lc:trainedOn lc:InstructGPT_RLHF .

lc:ChatGPT rdf:type owl:NamedIndividual , lc:AIModel ;
           rdfs:label "ChatGPT" ;
           lc:inheritsFrom lc:GPT35 .

lc:GPT4 rdf:type owl:NamedIndividual , lc:AIModel ;
        rdfs:label "GPT-4" ;
        lc:inheritsFrom lc:GPT35 .

lc:GPT4o rdf:type owl:NamedIndividual , lc:AIModel ;
         rdfs:label "GPT-4o" ;
         lc:inheritsFrom lc:GPT4 .

###  AIModel hasLineage ModelLineage
lc:GPT35 lc:hasLineage lc:Lineage_GPT3_to_GPT35 .
lc:ChatGPT lc:hasLineage lc:Lineage_GPT35_to_ChatGPT .
lc:GPT4 lc:hasLineage lc:Lineage_GPT35_to_GPT4 .
lc:GPT4o lc:hasLineage lc:Lineage_GPT4_to_GPT4o .

###  ExploitationRecord propagates to models
lc:SamaExploitationRecord lc:propagatesTo lc:GPT35 .
lc:SamaExploitationRecord lc:propagatesTo lc:ChatGPT .
lc:SamaExploitationRecord lc:propagatesTo lc:GPT4 .
lc:SamaExploitationRecord lc:propagatesTo lc:GPT4o .

###  ModelLineage individuals
lc:Lineage_GPT3_to_GPT35 rdf:type owl:NamedIndividual , lc:ModelLineage ;
                         rdfs:label "GPT-3 to GPT-3.5 Lineage" ;
                         lc:inheritanceType "fine-tuning+RLHF" ;
                         lc:exploitationInherited "true"^^xsd:boolean ;
                         lc:inheritanceDepth "1"^^xsd:integer .

lc:Lineage_GPT35_to_ChatGPT rdf:type owl:NamedIndividual , lc:ModelLineage ;
                            rdfs:label "GPT-3.5 to ChatGPT Lineage" ;
                            lc:inheritanceType "fine-tuning" ;
                            lc:exploitationInherited "true"^^xsd:boolean ;
                            lc:inheritanceDepth "2"^^xsd:integer .

lc:Lineage_GPT35_to_GPT4 rdf:type owl:NamedIndividual , lc:ModelLineage ;
                         rdfs:label "GPT-3.5 to GPT-4 Lineage" ;
                         lc:inheritanceType "fine-tuning+RLHF" ;
                         lc:exploitationInherited "true"^^xsd:boolean ;
                         lc:inheritanceDepth "2"^^xsd:integer .

lc:Lineage_GPT4_to_GPT4o rdf:type owl:NamedIndividual , lc:ModelLineage ;
                         rdfs:label "GPT-4 to GPT-4o Lineage" ;
                         lc:inheritanceType "fine-tuning" ;
                         lc:exploitationInherited "true"^^xsd:boolean ;
                         lc:inheritanceDepth "3"^^xsd:integer .


